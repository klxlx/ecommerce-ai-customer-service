# Example only. Do not apply this to the local machine without a real gateway.
# The application sends an SSE comment heartbeat every SSE_HEARTBEAT_SECONDS.
# Set the gateway read timeout comfortably above CHAT_TOTAL_BUDGET_SECONDS.

server {
    listen 80;
    server_name _;

    location /api/conversations/ {
        proxy_pass http://127.0.0.1:8000;

        # SSE must not be buffered or gzip-compressed by the gateway.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_set_header X-Accel-Buffering no;

        # > app total budget (60s) + heartbeat interval (15s) + margin.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
