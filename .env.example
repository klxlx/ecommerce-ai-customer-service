# --- Database ---
DATABASE_URL=postgresql+psycopg://cs_user:cs_password@localhost:5432/cs_db

# --- Chat model (OpenAI-compatible) ---
CHAT_MODEL=qwen-plus
ROUTER_MODEL=qwen-plus
KNOWLEDGE_MODEL=qwen-max
CHITCHAT_MODEL=qwen-flash
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=sk-your-chat-key

# --- Read-only weather MCP for chitchat ---
WEATHER_MCP_ENABLED=1
WEATHER_MCP_URL=http://127.0.0.1:8000/mcp/weather
WEATHER_MCP_TOOL=get_weather
WEATHER_MCP_TIMEOUT_SECONDS=8
WEATHER_MCP_AUTH_TOKEN=

# --- DashScope native embedding / rerank ---
DASHSCOPE_API_KEY=sk-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
RERANK_MODEL=text-rerank-v1

# --- Handoff ticket policy ---
# 余弦相似度达到该值视为同一问题；0.93 适用于 text-embedding-v3 短问题
HANDOFF_DEDUPE_SIMILARITY=0.93
HANDOFF_MAX_UNRESOLVED=2

# --- Auth ---
SESSION_TTL_HOURS=24

# --- App ---
LOG_LEVEL=INFO
# 1 = 使用内置 Mock 模型（无需 API Key）；接入真实模型时改为 0 并填写上方 Key
MOCK_PROVIDERS=1
