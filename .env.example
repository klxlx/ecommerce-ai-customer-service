# --- Database ---
DATABASE_URL=postgresql+psycopg://cs_user:cs_password@localhost:5432/cs_db

# --- Chat model (OpenAI-compatible) ---
CHAT_MODEL=qwen-flash
ROUTER_MODEL=qwen-flash
KNOWLEDGE_MODEL=qwen-flash
CHITCHAT_MODEL=qwen-flash
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=sk-your-chat-key

# --- Read-only weather MCP for chitchat ---
WEATHER_MCP_ENABLED=1
WEATHER_MCP_URL=http://127.0.0.1:8000/mcp/weather
WEATHER_MCP_TOOL=get_weather
WEATHER_MCP_TIMEOUT_SECONDS=8
WEATHER_MCP_AUTH_TOKEN=

# --- DashScope native embedding / rerank ---
DASHSCOPE_API_KEY=sk-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=text-rerank-v1

# --- Handoff ticket policy ---
# 余弦相似度达到该值视为同一问题；0.93 适用于 text-embedding-v3 短问题
HANDOFF_DEDUPE_SIMILARITY=0.93
HANDOFF_MAX_UNRESOLVED=2

# --- Provider resilience ---
# 流式回答在首 token 前失败时自动重试；已出 token 后改为非流式重生成并替换气泡。
STREAM_RETRY_ENABLED=1
STREAM_PARTIAL_FALLBACK_ENABLED=1

# --- SSE / gateway keep-alive ---
# 应用每 15 秒发送一个 SSE 注释帧；网关读超时应大于 60 秒总预算 + 心跳间隔
SSE_HEARTBEAT_SECONDS=15

# --- Asynchronous answer sentinel ---
# 默认使用 ROUTER_MODEL；如需单独指定，填 SENTINEL_MODEL
SENTINEL_ENABLED=1
SENTINEL_MODEL=qwen-flash
SENTINEL_TIMEOUT_SECONDS=8
SENTINEL_MAX_CONTEXT_CHARS=6000

# --- Photo return / vision ---
# 先用预训练 YOLOv8n ONNX；后续换 Qwen-VL 或自训 YOLO 时替换 provider/model
VISION_PROVIDER=yolo
YOLO_MODEL_PATH=models/yolov8n.onnx
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640
RETURN_IMAGE_DIR=data/return_images
RETURN_IMAGE_MAX_MB=10

# --- Semantic FAQ cache (Postgres + pgvector) ---
SEMANTIC_CACHE_ENABLED=1
SEMANTIC_CACHE_SIMILARITY=0.95
SEMANTIC_CACHE_MAX_RESULTS=3
# 可选：缓存问题单独使用一个可用的 embedding 模型；留空跟随 EMBEDDING_MODEL。
# 例如 text-embedding-v3 免费额度耗尽时，可设为 text-embedding-v4。
SEMANTIC_CACHE_EMBEDDING_MODEL=

# --- Auth ---
SESSION_TTL_HOURS=24

# --- App ---
LOG_LEVEL=INFO
# 1 = 使用内置 Mock 模型（无需 API Key）；接入真实模型时改为 0 并填写上方 Key
MOCK_PROVIDERS=1
